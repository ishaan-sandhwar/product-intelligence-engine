# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- env ---
.venv/
venv/
.env
.env.local

# --- data & artefacts (regenerated by the pipeline) ---
data/pie.db*
data/raw/*
data/processed/*
data/uploads/*
!data/**/.gitkeep
outputs/logs/*
outputs/exports/*
!outputs/**/.gitkeep

# The supplied catalogue and the delivery files ship with the submission: the
# deployed app has to have something to open, and a judge should be able to read
# the output without running anything.
!data/raw/Unihack_ Sample Dataset - Input.csv
!outputs/exports/submission_*.csv

# The processed catalogue ships too, so the deployed app opens with 1,000
# products already in it instead of an empty database. The -wal/-shm sidecars
# stay ignored; the snapshot is checkpointed before committing.
!data/pie.db

# Streamlit Cloud secrets - never committed.
.streamlit/secrets.toml
.llm_cache/

# Slide renders used to proof the deck locally, and the blank template the
# challenge supplies - neither is source.
docs/deck_preview/
*UniHack-Protoype Template*.pptx

# --- os / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
