# Copy to .env and fill in whichever provider you have. The client picks the
# first configured provider in PROVIDER_PRIORITY (config.py) and skips the rest,
# so exactly one key is enough to run the whole pipeline.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- optional runtime tuning (defaults shown) ---
LLM_CONCURRENCY=5
LLM_CACHE_ENABLED=1
BATCH_SIZE=25
